@render InteractiveComponent

<div class="bg-brand-orange px-4 py-2 text-center text-xs font-medium text-white">
    <a href="/" class="underline">Shop online</a> for free delivery. Call us at 1-800-000-0000 or
    <a href="/support" class="underline">visit support</a>.
</div>

<header class="sticky top-0 z-40 border-b border-gray-200 bg-white">
    <div class="mx-auto flex max-w-7xl items-center justify-between px-4 py-4">
        <a href="/" class="pixel-heading text-lg font-bold">EVERYTHING(e)</a>

        <!-- Desktop Navigation -->
        <nav class="hidden items-center gap-8 text-sm font-semibold tracking-wide md:flex">
            <NavLink href="/store" class="hover:text-brand-orange">STORE</NavLink>
            <NavLink href="/phones" class="hover:text-brand-orange">PHONES</NavLink>
            <NavLink href="/audio" class="hover:text-brand-orange">AUDIO</NavLink>
            <NavLink href="/watches" class="hover:text-brand-orange">WATCHES</NavLink>
            <NavLink href="/accessories" class="hover:text-brand-orange">ACCESSORIES</NavLink>
        </nav>

        <div class="flex items-center gap-3">
            <NavLink href="/login" class="btn-primary hidden !px-5 !py-2 md:inline-flex">Shop</NavLink>

            <!-- Mobile Menu Toggle Button -->
            <button type="button"
                    class="inline-flex h-10 w-10 items-center justify-center rounded-md border border-gray-300 text-gray-700 transition active:scale-90 md:hidden focus:outline-none"
                    @onclick="ToggleMobileMenu"
                    aria-label="Toggle navigation menu"
                    aria-expanded="@isMobileMenuOpen">
                @if (isMobileMenuOpen)
                {
                    <span class="text-xl">✕</span>
                }
                else
                {
                    <span class="text-xl">☰</span>
                }
            </button>
        </div>
    </div>

    <!-- Mobile Drawer & Backdrop -->
    <!-- Backdrop Overlay: Closes menu when clicking outside -->
    <div class="fixed inset-0 top-[calc(100%+1px)] z-30 bg-black/40 backdrop-blur-sm transition-opacity duration-300 md:hidden @(isMobileMenuOpen ? "opacity-100 pointer-events-auto" : "opacity-0 pointer-events-none")"
         @onclick="CloseMobileMenu">
    </div>

    <!-- Mobile Navigation Panel (Slides down smoothly) -->
    <div class="absolute left-0 right-0 top-full z-40 border-b border-gray-200 bg-white shadow-xl transition-all duration-300 ease-in-out md:hidden @(isMobileMenuOpen ? "max-h-96 opacity-100" : "max-h-0 opacity-0 overflow-hidden")">
        <nav class="flex flex-col gap-1 px-4 py-4 text-sm font-semibold">
            <NavLink href="/store" class="rounded-md px-3 py-2.5 transition-colors hover:bg-brand-gray active:bg-gray-100" @onclick="CloseMobileMenu">STORE</NavLink>
            <NavLink href="/phones" class="rounded-md px-3 py-2.5 transition-colors hover:bg-brand-gray active:bg-gray-100" @onclick="CloseMobileMenu">PHONES</NavLink>
            <NavLink href="/audio" class="rounded-md px-3 py-2.5 transition-colors hover:bg-brand-gray active:bg-gray-100" @onclick="CloseMobileMenu">AUDIO</NavLink>
            <NavLink href="/watches" class="rounded-md px-3 py-2.5 transition-colors hover:bg-brand-gray active:bg-gray-100" @onclick="CloseMobileMenu">WATCHES</NavLink>
            <NavLink href="/accessories" class="rounded-md px-3 py-2.5 transition-colors hover:bg-brand-gray active:bg-gray-100" @onclick="CloseMobileMenu">ACCESSORIES</NavLink>
            <NavLink href="/login" class="btn-primary mt-3 flex justify-center !py-3 text-center" @onclick="CloseMobileMenu">Shop</NavLink>
        </nav>
    </div>
</header>

@code {
    private bool isMobileMenuOpen = false;

    private void ToggleMobileMenu()
    {
        isMobileMenuOpen = !isMobileMenuOpen;
    }

    private void CloseMobileMenu()
    {
        isMobileMenuOpen = false;
    }
}