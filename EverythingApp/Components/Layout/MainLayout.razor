@inherits LayoutComponentBase
@using EverythingApp.Components.Layout

<div class="min-h-screen bg-white text-black flex flex-col">

    <Header />

    <!-- 2. MAIN CONTENT (Constrained page content only) -->
    <main class="flex-1 w-full bg-[url(/images/bg.png)] bg-center">
        @Body
    </main>


    <Footer />

</div>

<!-- Blazor Unhandled Error Notification UI -->
<div id="blazor-error-ui" class="hidden bg-amber-500 text-slate-950 px-4 py-2 text-xs font-semibold flex items-center justify-between">
    <span>An unhandled error has occurred.</span>
    <a href="" class="underline ml-2">Reload</a>
</div>