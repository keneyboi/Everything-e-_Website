<!-- STREAMING_CHUNK:Updating MainLayout razor markup... -->
@inherits LayoutComponentBase

<div class="min-h-screen bg-slate-950 text-slate-100 flex flex-col">

    <!-- 1. HERE IS WHERE YOU CALL YOUR NAVBAR COMPONENT -->
    <NavMenu />

    <!-- 2. MAIN CONTENT AREA WHERE @Body RENDERS YOUR PAGES -->
    <main class="flex-1 max-w-7xl w-full mx-auto p-4 sm:p-6 lg:p-8">
        @Body
    </main>

</div>

<!-- Blazor Unhandled Error Notification UI -->
<div id="blazor-error-ui" class="hidden bg-amber-500 text-slate-950 px-4 py-2 text-xs font-semibold flex items-center justify-between">
    <span>An unhandled error has occurred.</span>
    <a href="" class="underline ml-2">Reload</a>
</div>