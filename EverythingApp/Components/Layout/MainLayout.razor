@inherits LayoutComponentBase

<div class="flex min-h-screen flex-col">
    <Header />

    <main class="flex-1">
        @Body
    </main>

    <Footer />
</div>

<div id="blazor-error-ui" class="fixed inset-x-0 bottom-0 hidden bg-red-600 px-4 py-3 text-sm text-white">
    An unhandled error has occurred.
    <a href="" class="ml-2 underline">Reload</a>
    <a class="ml-2 cursor-pointer underline dismiss">Dismiss</a>
</div>
