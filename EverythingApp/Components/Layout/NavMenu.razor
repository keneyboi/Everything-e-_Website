<!-- STREAMING_CHUNK:Defining NavMenu razor markup... -->
<nav class="bg-slate-900 border-b border-slate-800 text-white sticky top-0 z-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-16">
            
            <!-- Brand Identity -->
            <div class="flex items-center space-x-3 cursor-pointer">
                <div class="w-8 h-8 rounded-lg bg-indigo-600 flex items-center justify-center font-bold text-white shadow-md shadow-indigo-600/30">
                    A
                </div>
                <span class="font-bold text-base tracking-tight">AcmeCorp</span>
            </div>

            <!-- Desktop Navigation Links -->
            <div class="hidden md:flex items-center space-x-6 text-xs font-medium">
                <NavLink href="" Match="NavLinkMatch.All" class="text-slate-300 hover:text-indigo-400 transition" ActiveClass="text-indigo-400 font-semibold">
                    Home
                </NavLink>
                <NavLink href="counter" class="text-slate-300 hover:text-indigo-400 transition" ActiveClass="text-indigo-400 font-semibold">
                    Counter
                </NavLink>
                <NavLink href="fetchdata" class="text-slate-300 hover:text-indigo-400 transition" ActiveClass="text-indigo-400 font-semibold">
                    Analytics
                </NavLink>
            </div>

            <!-- CTA Button -->
            <div class="hidden md:flex items-center">
                <button @onclick="OnCtaClick" class="px-4 py-2 bg-indigo-600 hover:bg-indigo-500 text-white rounded-xl text-xs font-semibold transition active:scale-95 shadow-lg shadow-indigo-600/20">
                    Get Started
                </button>
            </div>

            <!-- Mobile Hamburger Toggle -->
            <div class="md:hidden flex items-center">
                <button @onclick="ToggleMobileMenu" class="p-2 rounded-lg text-slate-400 hover:text-white transition" aria-label="Toggle menu">
                    <i class="fa-solid @(isMobileOpen ? "fa-xmark" : "fa-bars") text-lg"></i>
                </button>
            </div>

        </div>
    </div>

    <!-- Mobile Drawer Dropdown -->
    @if (isMobileOpen)
    {
        <div class="md:hidden border-t border-slate-800 bg-slate-900/95 px-4 py-3 space-y-2 animate-in slide-in-from-top duration-200">
            <NavLink href="" Match="NavLinkMatch.All" class="block py-2 text-xs text-slate-300 hover:text-indigo-400" @onclick="CloseMenu">
                Home
            </NavLink>
            <NavLink href="counter" class="block py-2 text-xs text-slate-300 hover:text-indigo-400" @onclick="CloseMenu">
                Counter
            </NavLink>
            <NavLink href="fetchdata" class="block py-2 text-xs text-slate-300 hover:text-indigo-400" @onclick="CloseMenu">
                Analytics
            </NavLink>
            <div class="pt-2">
                <button @onclick="OnCtaClick" class="w-full py-2 bg-indigo-600 text-white rounded-lg text-xs font-semibold">
                    Get Started
                </button>
            </div>
        </div>
    }
</nav>

@code {
    private bool isMobileOpen = false;

    private void ToggleMobileMenu()
    {
        isMobileOpen = !isMobileOpen;
    }

    private void CloseMenu()
    {
        isMobileOpen = false;
    }

    private void OnCtaClick()
    {
        // Custom action logic here
    }
}