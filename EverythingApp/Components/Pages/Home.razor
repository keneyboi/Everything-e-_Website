<section class="cta-section">
    <div class="cta-content">
        <h2>Ready to Experience Everything?</h2>
        <p>Join millions of users who have chosen the premium integrated ecosystem.</p>
        <div class="cta-buttons">
            <NavLink href="/login" class="orange-button" Match="NavLinkMatch.All">GET STARTED NOW</NavLink>
            <button class="keynote-button">LEARN MORE</button>
        </div>
    </div>
</section>

<section class="testimonials-section">
    <div class="container">
        <h2>What Our Customers Say</h2>
        <div class="testimonials-grid">
