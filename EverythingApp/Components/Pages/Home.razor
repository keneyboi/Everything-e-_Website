            </div>
            <div class="testimonial-card">
                <div class="stars">★★★★★</div>
                <p class="testimonial-text">"Best ecosystem I've ever experienced. Worth every penny!"</p>
                <p class="testimonial-author">- Emma Thompson, Developer</p>
            </div>
        </div>
    </div>
</section>

