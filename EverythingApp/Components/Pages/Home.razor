@page "/"
@layout EverythingApp.Components.Layout.MainLayout

<PageTitle>EVERYTHING(e) - Premium Hardware Ecosystem</PageTitle>

<HeroSection />
<FeatureSection />

<!-- Call to Action Section -->
<section class="my-16 px-4">
    <div class="max-w-5xl mx-auto bg-gradient-to-r from-indigo-950/60 via-slate-900 to-indigo-950/60 border border-slate-800 rounded-2xl p-8 sm:p-12 text-center shadow-2xl relative overflow-hidden">
        <div class="relative z-10 space-y-6">
            <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
                Ready to Experience Everything?
            </h2>
            <p class="text-slate-300 max-w-xl mx-auto text-base sm:text-lg">
                Join millions of users who have chosen the premium integrated ecosystem.
            </p>
            <div class="flex flex-col sm:flex-row items-center justify-center gap-4 pt-2">
                <NavLink href="/login" Match="NavLinkMatch.All" class="w-full sm:w-auto px-6 py-3.5 bg-orange-500 hover:bg-orange-400 text-slate-950 font-bold rounded-xl text-xs tracking-wider uppercase transition shadow-lg shadow-orange-500/20 active:scale-95">
                    GET STARTED NOW
                </NavLink>
                <button class="w-full sm:w-auto px-6 py-3.5 bg-slate-800 hover:bg-slate-700 text-slate-200 font-semibold rounded-xl text-xs tracking-wider uppercase border border-slate-700 transition active:scale-95">
                    LEARN MORE
                </button>
            </div>
        </div>
    </div>
</section>

<!-- Testimonials Section -->
<section class="py-16 bg-slate-950">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-10">
        <h2 class="text-2xl sm:text-3xl font-extrabold text-center text-white tracking-tight">
            What Our Customers Say
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <!-- Card 1 -->
            <div class="bg-slate-900/80 border border-slate-800 rounded-2xl p-6 flex flex-col justify-between space-y-4 shadow-lg hover:border-slate-700 transition">
                <div class="space-y-3">
                    <div class="text-amber-400 tracking-widest text-sm">★★★★★</div>
                    <p class="text-slate-300 text-sm leading-relaxed">
                        "The integration between all devices is seamless. Everything just works perfectly together."
                    </p>
                </div>
                <p class="text-xs font-semibold text-indigo-400">- Sarah Chen, Tech Enthusiast</p>
            </div>

            <!-- Card 2 -->
            <div class="bg-slate-900/80 border border-slate-800 rounded-2xl p-6 flex flex-col justify-between space-y-4 shadow-lg hover:border-slate-700 transition">
                <div class="space-y-3">
                    <div class="text-amber-400 tracking-widest text-sm">★★★★★</div>
                    <p class="text-slate-300 text-sm leading-relaxed">
                        "Premium quality at a fair price. The transparent design looks absolutely stunning."
                    </p>
                </div>
                <p class="text-xs font-semibold text-indigo-400">- Michael Rodriguez, Designer</p>
            </div>

            <!-- Card 3 -->
            <div class="bg-slate-900/80 border border-slate-800 rounded-2xl p-6 flex flex-col justify-between space-y-4 shadow-lg hover:border-slate-700 transition">
                <div class="space-y-3">
                    <div class="text-amber-400 tracking-widest text-sm">★★★★★</div>
                    <p class="text-slate-300 text-sm leading-relaxed">
                        "Best ecosystem I've ever experienced. Worth every penny!"
                    </p>
                </div>
                <p class="text-xs font-semibold text-indigo-400">- Emma Thompson, Developer</p>
            </div>
        </div>
    </div>
</section>

<!-- Newsletter Section -->
<section class="py-16 bg-slate-900/40 border-y border-slate-800">
    <div class="max-w-2xl mx-auto px-4 text-center space-y-6">
        <div class="space-y-2">
            <h2 class="text-2xl sm:text-3xl font-extrabold text-white">Stay Updated</h2>
            <p class="text-slate-400 text-sm">Get the latest news about new releases and exclusive offers.</p>
        </div>
        <form class="flex flex-col sm:flex-row gap-3 max-w-md mx-auto">
            <input type="email" placeholder="Enter your email" required class="flex-1 bg-slate-950 border border-slate-800 rounded-xl px-4 py-3 text-sm text-slate-100 placeholder-slate-500 focus:outline-none focus:border-indigo-500 transition" />
            <button type="submit" class="px-6 py-3 bg-orange-500 hover:bg-orange-400 text-slate-950 font-bold rounded-xl text-xs tracking-wider uppercase transition shadow-md shadow-orange-500/20 active:scale-95">
                SUBSCRIBE
            </button>
        </form>
    </div>
</section>

