@page "/"
@layout EverythingApp.Components.Layout.MainLayout



<PageTitle>EVERYTHING(e) - Premium Hardware Ecosystem</PageTitle>

<HeroSection />
<FeatureSection />
<RatingSection />

<!-- Newsletter Section -->
<section class="border-t border-gray-200 bg-white py-16">
    <div class="mx-auto max-w-2xl px-4 text-center">
        <div class="mb-6 space-y-2">
            <h2 class="pixel-heading text-2xl font-bold uppercase tracking-tight text-brand-dark sm:text-3xl">
                Stay Updated
            </h2>
            <p class="text-xs font-medium text-gray-600 sm:text-sm">
                Get the latest news about new releases and exclusive offers.
            </p>
        </div>
        
        <form @onsubmit:preventDefault class="mx-auto flex max-w-md flex-col gap-3 sm:flex-row">
            <input type="email" 
                   placeholder="Enter your email" 
                   required 
                   class="flex-1 rounded-md border border-gray-300 bg-white px-4 py-2.5 text-xs font-medium text-black placeholder-gray-400 focus:border-black focus:outline-none" />
            
            <button type="submit" 
                    class="btn-primary inline-flex items-center justify-center rounded-md !px-6 !py-2.5 text-xs font-bold uppercase tracking-wider active:scale-95">
                SUBSCRIBE
            </button>
        </form>
    </div>
</section>

<Footer />