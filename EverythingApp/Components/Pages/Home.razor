@page "/"

<PageTitle>EVERYTHING(e) - Premium Hardware Ecosystem</PageTitle>

<HeroSection />
<FeatureSection />

<section class="bg-brand-dark py-16 text-center text-white">
    <div class="mx-auto max-w-2xl px-4">
        <h2 class="text-2xl sm:text-3xl">Ready to Experience Everything?</h2>
        <p class="mt-3 text-sm text-gray-300">
            Join millions of users who have chosen the premium integrated ecosystem.
        </p>
        <div class="mt-6 flex flex-col items-center justify-center gap-3 sm:flex-row">
            <NavLink href="/login" class="btn-primary" Match="NavLinkMatch.All">GET STARTED NOW</NavLink>
            <button type="button" class="btn-secondary !border-white !text-white hover:!bg-white hover:!text-brand-dark">
                LEARN MORE
            </button>
        </div>
    </div>
</section>

<section class="bg-brand-gray py-16">
    <div class="mx-auto max-w-6xl px-4">
        <h2 class="mb-10 text-center text-2xl">What Our Customers Say</h2>
        <div class="grid grid-cols-1 gap-6 sm:grid-cols-3">
            <div class="rounded-lg bg-white p-6 shadow-sm">
                <div class="text-brand-orange">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
                <p class="mt-3 text-sm text-gray-600">
                    "The integration between all devices is seamless. Everything just works perfectly together."
                </p>
                <p class="mt-4 text-xs font-semibold text-gray-500">- Sarah Chen, Tech Enthusiast</p>
            </div>
            <div class="rounded-lg bg-white p-6 shadow-sm">
                <div class="text-brand-orange">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
                <p class="mt-3 text-sm text-gray-600">
                    "Premium quality at a fair price. The transparent design looks absolutely stunning."
                </p>
                <p class="mt-4 text-xs font-semibold text-gray-500">- Michael Rodriguez, Designer</p>
            </div>
            <div class="rounded-lg bg-white p-6 shadow-sm">
                <div class="text-brand-orange">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
                <p class="mt-3 text-sm text-gray-600">
                    "Best ecosystem I've ever experienced. Worth every penny!"
                </p>
                <p class="mt-4 text-xs font-semibold text-gray-500">- Emma Thompson, Developer</p>
            </div>
        </div>
    </div>
</section>

<section class="bg-brand-orange py-14 text-center text-white">
    <div class="mx-auto max-w-xl px-4">
        <h2 class="text-2xl">Stay Updated</h2>
        <p class="mt-2 text-sm text-white/90">Get the latest news about new releases and exclusive offers.</p>
        <form class="mt-6 flex flex-col gap-3 sm:flex-row" @onsubmit="HandleNewsletterSubmit" @onsubmit:preventDefault="true">
            <input type="email" placeholder="Enter your email" required
                   @bind="newsletterEmail"
                   class="input-field flex-1 !border-white/40" />
            <button type="submit" class="btn-primary !bg-brand-dark hover:!bg-black" disabled="@isSubscribing">
                @(isSubscribing ? "SUBSCRIBING..." : "SUBSCRIBE")
            </button>
        </form>
        @if (!string.IsNullOrEmpty(newsletterMessage))
        {
            <p class="mt-3 text-sm font-medium">@newsletterMessage</p>
        }
    </div>
</section>

@code {
    private string newsletterEmail = string.Empty;
    private bool isSubscribing = false;
    private string newsletterMessage = string.Empty;

    private async Task HandleNewsletterSubmit()
    {
        isSubscribing = true;
        newsletterMessage = string.Empty;
        await Task.Delay(800);
        newsletterMessage = $"Thanks! We'll send updates to {newsletterEmail}.";
        newsletterEmail = string.Empty;
        isSubscribing = false;
    }
}
