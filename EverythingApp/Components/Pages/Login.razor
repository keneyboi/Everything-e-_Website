@page "/login"

@using System.ComponentModel.DataAnnotations
@inject NavigationManager Navigation

<PageTitle>Login - EVERYTHING(e)</PageTitle>

<!-- Outer Container: Centers content vertically/horizontally and scales padding based on breakpoint -->
<div class="flex min-h-[calc(100vh-4rem)] w-full items-center justify-center px-4 py-8 sm:px-6 sm:py-12 md:py-16">
    <!-- Card Container: Responsive width scaling from mobile (full width / max-w-sm) to desktop (max-w-md) -->
    <div class="w-full max-w-sm sm:max-w-md rounded-lg  py-12 px-8 shadow-sm bg-gray-100/70 backdrop-blur-md">
        
        <!-- Header Text: Responsive sizing -->
        <h1 class="serif-text text-4xl">LOGIN</h1>
        <p class="mt-1.5 text-xs text-gray-500">Enter login details to continue shopping</p>

        <!-- Form: Flexible vertical spacing -->
        <EditForm Model="loginModel" OnValidSubmit="HandleLogin" class="mt-6 ">
            <DataAnnotationsValidator />
            <p class="ml-1 my-1.5 text-xs text-gray-500">Username</p>
            <div>
                <InputText id="username"
                           @bind-Value="loginModel.Username"
                           class="w-full rounded-md border border-gray-300 bg-white px-4 py-2.5 text-xs font-medium text-black placeholder-gray-400 focus:border-black focus:outline-none"
                           placeholder="Enter Username"
                           autocomplete="username" />
                <ValidationMessage For="() => loginModel.Username" class="field-error text-xs sm:text-sm" />
            </div>
            <p class="ml-1 mt-5 mb-1.5 text-xs text-gray-500">Password</p>
            <div>
                <InputText id="password"
                           @bind-Value="loginModel.Password"
                           type="password"
                           class="w-full rounded-md border border-gray-300 bg-white px-4 py-2.5 text-xs font-medium text-black placeholder-gray-400 focus:border-black focus:outline-none"
                           placeholder="Enter Password"
                           autocomplete="current-password" />
                <ValidationMessage For="() => loginModel.Password" class="field-error text-xs sm:text-sm" />
            </div>

            <button type="submit" class="bg-orange-600 text-white rounded-xl mt-7 w-full !py-3 sm:!py-3.5 text-sm sm:text-base font-semibold" disabled="@isSubmitting">
                @(isSubmitting ? "LOGGING IN..." : "LOGIN")
            </button>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="rounded-md bg-red-50 px-3 py-2 text-xs sm:px-4 sm:text-sm text-red-600 break-words">@errorMessage</div>
            }
            @if (!string.IsNullOrEmpty(successMessage))
            {
                <div class="rounded-md bg-green-50 px-3 py-2 text-xs sm:px-4 sm:text-sm text-green-700 break-words">@successMessage</div>
            }
        </EditForm>

        <p class="mt-5 text-center text-xs text-gray-500 sm:mt-6 sm:text-sm">
            Don't have an account?
            <NavLink href="/register" class="font-semibold text-brand-orange hover:underline">Register</NavLink>
        </p>
    </div>
</div>

@code {
    private LoginModel loginModel = new();
    private string errorMessage = string.Empty;
    private string successMessage = string.Empty;
    private bool isSubmitting = false;

    private async Task HandleLogin()
    {
        errorMessage = string.Empty;
        successMessage = string.Empty;
        isSubmitting = true;

        try
        {
            // TODO: replace with real authentication
            await Task.Delay(600);
            if (loginModel.Username == "demo" && loginModel.Password == "demo123")
            {
                successMessage = "Login successful! Redirecting...";
                await Task.Delay(800);
                Navigation.NavigateTo("/");
            }
            else
            {
                errorMessage = "Invalid username or password. Try demo / demo123";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"An error occurred: {ex.Message}";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    public class LoginModel
    {
        [Required(ErrorMessage = "Username is required")]
        public string Username { get; set; } = string.Empty;

        [Required(ErrorMessage = "Password is required")]
        [StringLength(100, MinimumLength = 6, ErrorMessage = "Password must be at least 6 characters")]
        public string Password { get; set; } = string.Empty;
    }
}