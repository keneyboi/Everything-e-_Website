<div class="flex flex-col rounded-lg border border-gray-200 bg-white p-5 shadow-sm transition hover:shadow-md">
    <span class="text-xs font-bold tracking-wide text-brand-orange">@Category</span>
    <h3 class="mt-1 text-lg font-bold">@Title</h3>

    <div class="mt-4 flex h-40 items-center justify-center rounded-md bg-brand-gray">
        @if (!string.IsNullOrWhiteSpace(Image))
        {
            <img src="@Image" alt="@Title" class="max-h-36 max-w-full object-contain" />
        }
        else
        {
            <span class="text-xs text-gray-400">Drop product image here</span>
        }
    </div>

    <ul class="mt-4 flex-1 space-y-1 text-xs text-gray-600">
        @Details
    </ul>

    <button type="button" class="btn-primary mt-5 w-full">EXPLORE @Title.ToUpper()</button>
</div>

@code {
    [Parameter]
    public string Category { get; set; } = "CATEGORY";

    [Parameter]
    public string Title { get; set; } = "Title";

    [Parameter]
    public string? Image { get; set; }

    [Parameter]
    public RenderFragment? Details { get; set; }
}
